# Server
PORT=4000
# Only used for direct browser calls; the frontend proxies /api/* itself.
CORS_ORIGIN=http://localhost:3000

# Supabase — Dashboard > Settings > API.
# Run schema.sql in the SQL Editor before the first start.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=site-images

# Admin panel. Change both before deploying.
# ADMIN_SESSION_SECRET must match frontend/.env.local — generate with:
#   openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Only needed when the API is hosted on a different site to the frontend.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.yourdomain.com

# Email notifications. Optional — enquiries are stored either way.
BUSINESS_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=
